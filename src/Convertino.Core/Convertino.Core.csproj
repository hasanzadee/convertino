<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Convertino</RootNamespace>
    <AssemblyName>Convertino.Core</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- QR codes: ZXing.Net reads (fed raw pixels), QRCoder writes PNG itself; 1.6.0 is the last line whose net6.0 build doesn't pull System.Drawing.Common -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- API only; each app brings the native runtime (DirectML on Windows, CPU on Linux) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" />
    <!-- 6.2.x is the last MIT release; 6.5 moved to AGPL/commercial with a runtime license check -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp 6.2.4 pulls an 8.0.x Pkcs with published advisories; lift it -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
